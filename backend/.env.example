# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon (public) key
SUPABASE_KEY=

# Public URL of the deployed backend, e.g. https://your-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=
