# Copy to frontend/.env.local and fill in real values. Never commit .env.local.
# These are NEXT_PUBLIC_* so they are bundled into the browser build — put only
# public values here (the Supabase anon key is public by design; the service_role
# key is NOT and must never appear in this file).
#
# The same three variables must also be set in your Vercel project settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=
